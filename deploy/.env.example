# Copy to /opt/workmates/.env on the VPS and chmod 600. Never commit the real file.
# Values with special characters (such as $) need single quotes: Compose also reads this file.
# For local development, run the backend with SPRING_PROFILES_ACTIVE=local; the other
# variables then have development defaults and can be left out.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL runs on the host; host.docker.internal reaches it from the container
DB_URL=jdbc:postgresql://host.docker.internal:5432/workmates
DB_USERNAME=workmates
DB_PASSWORD=change-me

# Base64, at least 32 random bytes: openssl rand -base64 32
# Do not reuse the development key from application-local.yml
JWT_SECRET=change-me
# Token lifetime, for example 7d or 12h
JWT_TTL=7d
